{
  "additionalProperties": false,
  "description": "One fill. Fees and slippage are non-negative.",
  "properties": {
    "executed_at": {
      "format": "date-time",
      "title": "Executed At",
      "type": "string"
    },
    "execution_id": {
      "minLength": 1,
      "title": "Execution Id",
      "type": "string"
    },
    "fees": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Fees"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "order_id": {
      "minLength": 1,
      "title": "Order Id",
      "type": "string"
    },
    "price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Price"
    },
    "quantity": {
      "exclusiveMinimum": 0,
      "title": "Quantity",
      "type": "integer"
    },
    "slippage": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Slippage"
    },
    "symbol": {
      "minLength": 1,
      "title": "Symbol",
      "type": "string"
    },
    "venue": {
      "minLength": 1,
      "title": "Venue",
      "type": "string"
    }
  },
  "required": [
    "execution_id",
    "order_id",
    "symbol",
    "quantity",
    "price",
    "executed_at",
    "fees",
    "slippage",
    "venue",
    "metadata"
  ],
  "title": "Execution",
  "type": "object"
}
