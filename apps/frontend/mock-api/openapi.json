  "components": {
    "schemas": {
      "AgentName": {
        "type": "string",
        "enum": [
          "technical",
          "momentum",
          "mean_reversion",
          "volume",
          "regime",
          "ml",
          "news",
          "fundamental",
          "valuation",
          "earnings"
        ],
        "title": "AgentName"
      },
      "Exchange": {
        "type": "string",
        "enum": [
          "NSE",
          "BSE"
        ],
        "title": "Exchange"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Horizon": {
        "type": "string",
        "enum": [
          "INTRADAY",
          "SWING",
          "LONG_TERM"
        ],
        "title": "Horizon"
      },
      "ProvisionalAgentScore": {
        "properties": {
          "agent_name": {
            "$ref": "#/components/schemas/AgentName"
          },
          "signal": {
            "type": "number",
            "title": "Signal"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "horizon": {
            "$ref": "#/components/schemas/Horizon"
          }
        },
        "type": "object",
        "required": [
          "agent_name",
          "signal",
          "confidence",
          "horizon"
        ],
        "title": "ProvisionalAgentScore"
      },
      "ProvisionalMarketOverview": {
        "properties": {
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "nifty_last": {
            "type": "string",
            "title": "Nifty Last"
          },
          "breadth_advancers": {
            "type": "integer",
            "title": "Breadth Advancers"
          },
          "breadth_decliners": {
            "type": "integer",
            "title": "Breadth Decliners"
          },
          "mode": {
            "$ref": "#/components/schemas/TradingMode"
          }
        },
        "type": "object",
        "required": [
          "as_of",
          "nifty_last",
          "breadth_advancers",
          "breadth_decliners",
          "mode"
        ],
        "title": "ProvisionalMarketOverview"
      },
      "ProvisionalPerformance": {
        "properties": {
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "total_pnl": {
            "type": "string",
            "title": "Total Pnl"
          },
          "sharpe_placeholder": {
            "type": "string",
            "title": "Sharpe Placeholder",
            "description": "Not a live metric"
          }
        },
        "type": "object",
        "required": [
          "as_of",
          "total_pnl",
          "sharpe_placeholder"
        ],
        "title": "ProvisionalPerformance"
      },
      "ProvisionalRiskStatus": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/RiskStatus"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "status",
          "as_of",
          "message"
        ],
        "title": "ProvisionalRiskStatus"
      },
      "ProvisionalStock": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "exchange": {
            "$ref": "#/components/schemas/Exchange"
          },
          "last_price": {
            "type": "string",
            "title": "Last Price"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "exchange",
          "last_price"
        ],
        "title": "ProvisionalStock"
      },
      "ProvisionalSystemStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "contract_version": {
            "type": "string",
            "title": "Contract Version"
          },
          "trading_mode": {
            "$ref": "#/components/schemas/TradingMode"
          },
          "live_enabled": {
            "type": "boolean",
            "title": "Live Enabled"
          },
          "exchange_scope": {
            "type": "string",
            "title": "Exchange Scope"
          }
        },
        "type": "object",
        "required": [
          "status",
          "contract_version",
          "trading_mode",
          "live_enabled",
          "exchange_scope"
        ],
        "title": "ProvisionalSystemStatus"
      },
      "RiskStatus": {
        "type": "string",
        "enum": [
          "APPROVED",
          "REJECTED"
        ],
        "title": "RiskStatus"
      },
      "TradingMode": {
        "type": "string",
        "enum": [
          "BACKTEST",
          "PAPER",
          "SHADOW",
          "LIVE"
        ],
        "title": "TradingMode"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}