FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir alembic psycopg[binary] redis
COPY packages/contracts /app/packages/contracts
COPY services/core /app/services/core
RUN pip install --no-cache-dir \
    -e /app/packages/contracts \
    -e /app/services/core/db \
    -e /app/services/core/candle-engine \
    -e /app/services/core/feature-engine \
    -e /app/services/core/signal-ingestion \
    -e /app/services/core/market-data \
    -e /app/services/core/signal-fusion \
    -e /app/services/core/decision-engine \
    -e /app/services/core/risk-engine \
    -e /app/services/core/paper-execution \
    -e /app/services/core/worker \
    -e /app/services/core/api
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["uvicorn", "core_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
