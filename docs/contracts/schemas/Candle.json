{
  "$defs": {
    "Exchange": {
      "enum": [
        "NSE",
        "BSE"
      ],
      "title": "Exchange",
      "type": "string"
    },
    "Timeframe": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "1d"
      ],
      "title": "Timeframe",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One OHLCV bar. end is the time the bar became knowable.",
  "properties": {
    "close": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Close"
    },
    "end": {
      "format": "date-time",
      "title": "End",
      "type": "string"
    },
    "exchange": {
      "$ref": "#/$defs/Exchange"
    },
    "high": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "High"
    },
    "low": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Low"
    },
    "open": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Open"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    },
    "symbol": {
      "minLength": 1,
      "title": "Symbol",
      "type": "string"
    },
    "timeframe": {
      "$ref": "#/$defs/Timeframe"
    },
    "volume": {
      "minimum": 0,
      "title": "Volume",
      "type": "integer"
    }
  },
  "required": [
    "symbol",
    "exchange",
    "timeframe",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "start",
    "end"
  ],
  "title": "Candle",
  "type": "object"
}
