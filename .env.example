CORE_API_TOKEN=change-me
INTERNAL_SIGNAL_TOKEN=change-me
MAX_CLOCK_SKEW_SECONDS=5
TRADING_MODE=PAPER
DATABASE_URL=postgresql+psycopg://core:core@postgres:5432/core
REDIS_URL=redis://redis:6379/0
WORKER_INTERVAL_SECONDS=30
PAPER_STARTING_CASH=1000000
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Incremental candle polling runs in core-api, not core-worker.
# It stays idle until a Zerodha login callback stores an in-memory access token.
# MARKET_DATA_COLLECTOR=true
# MARKET_DATA_POLL_SECONDS=60
# PAPER_REQUIRE_FRESH_CANDLES=true

# Optional. Leave unset for the standard paper demo.
# QUANT_ML_DEMO=true is allowed only with TRADING_MODE/QUANT_TRADING_MODE=PAPER.
# It trains a synthetic, unvalidated model into QUANT_ML_DEMO_DIR. Do not point that
# directory at QUANT_ARTIFACT_DIR. The two settings cannot be set together.
# QUANT_ARTIFACT_DIR loads an existing artifact and does not train.
# QUANT_ML_DEMO=false
# QUANT_ML_DEMO_DIR=
# QUANT_ARTIFACT_DIR=
# INTELLIGENCE_DATA_SOURCE=fixtures
# NEWS_RSS_URLS=
# INTELLIGENCE_FUNDAMENTALS_CSV=

# Frontend operator sign-in (settings, manual paper orders, strategies). Leave empty for a read-only site.
OPERATOR_PASSWORD=
OPERATOR_SESSION_SECRET=

# Notifications (worker + deploy/healthcheck.sh). Telegram: create a bot with @BotFather, then get your chat id
# from https://api.telegram.org/bot<token>/getUpdates after messaging the bot. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Slack/Discord incoming webhook instead of (or as well as) Telegram.
ALERT_WEBHOOK_URL=
# Link included in the daily summary.
PUBLIC_SITE_URL=
